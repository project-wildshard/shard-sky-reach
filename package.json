{
  "name": "@wildshard/shard-sky-reach",
  "version": "0.0.0",
  "private": true,
  "description": "Sky Reach: a Wildshard shard.",
  "type": "module",
  "bin": {
    "shard-sky-reach": "./src/cli/main.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p src/tsconfig.json",
    "lint": "oxlint -c src/.oxlintrc.json --type-aware --deny-warnings --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**' --ignore-pattern 'src/shards/**' --ignore-pattern 'test/**' --ignore-pattern 'public/**' --ignore-pattern 'scripts/**' --ignore-pattern 'vitest.config.ts' --no-error-on-unmatched-pattern && pnpm lint:shards",
    "lint:fix": "oxlint -c src/.oxlintrc.json --type-aware --fix --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**'",
    "format": "oxfmt -c src/.oxfmtrc.json src '!src/shards/**' '!test/**' '!.oxlintrc.author.json'",
    "format:check": "oxfmt -c src/.oxfmtrc.json --check src '!src/shards/**' '!test/**' '!.oxlintrc.author.json'",
    "test": "pnpm test:kit && pnpm test:shards",
    "check:asks": "node src/scripts/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node scripts/agent-parity.mjs --strict",
    "check:agent-sync": "node scripts/agent-sync.mjs --check",
    "test:agent-hooks": "node --test '.agents/hooks/test/*.test.mjs'",
    "agents:sync": "node scripts/agent-sync.mjs",
    "md:wrap": "node src/scripts/md-wrap.mjs",
    "test:hooks": "node --test '.githooks/*.test.mjs'",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:kit && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm test:agent-hooks && pnpm check:parity && node --check scripts/chromium-keychain-check.mjs && node --test test/tooling/chrome-keychain.test.mjs test/tooling/worktree-guard.test.mjs",
    "build:shards": "node scripts/publish-public.mjs && wildshard build-shards",
    "pack:shards": "node scripts/pack-all.mjs",
    "test:kit": "node --test 'src/cli/*.test.ts' 'src/test/**/*.test.ts'",
    "test:shards": "vitest run",
    "lint:shards": "WILDSHARD_RATCHET_FILE=lint/ratchet.json oxlint -c .oxlintrc.author.json --deny-warnings src/shards"
  },
  "dependencies": {
    "@wildshard/engine": "github:project-wildshard/engine#867f3b968429d8b90ae33b363dae3f15f16f6b84",
    "@wildshard/format": "github:project-wildshard/shard-format#17539ea88a9b56449d6cf9af7739b7f298be112e",
    "@wildshard/sharddev": "github:project-wildshard/sharddev#efbdc256b95bb5a438be984acfc920db5edf0bc1",
    "three": "0.186.0",
    "valibot": "1.5.0",
    "vitest": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@typescript/typescript6": "6.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@esbuild/aix-ppc64",
      "@esbuild/android-arm",
      "@esbuild/android-arm64",
      "@esbuild/android-x64",
      "@esbuild/darwin-x64",
      "@esbuild/freebsd-arm64",
      "@esbuild/freebsd-x64",
      "@esbuild/linux-arm",
      "@esbuild/linux-arm64",
      "@esbuild/linux-ia32",
      "@esbuild/linux-loong64",
      "@esbuild/linux-mips64el",
      "@esbuild/linux-ppc64",
      "@esbuild/linux-riscv64",
      "@esbuild/linux-s390x",
      "@esbuild/netbsd-arm64",
      "@esbuild/netbsd-x64",
      "@esbuild/openbsd-arm64",
      "@esbuild/openbsd-x64",
      "@esbuild/openharmony-arm64",
      "@esbuild/sunos-x64",
      "@esbuild/win32-arm64",
      "@esbuild/win32-ia32",
      "@esbuild/win32-x64",
      "@oxfmt/binding-android-arm-eabi",
      "@oxfmt/binding-android-arm64",
      "@oxfmt/binding-darwin-x64",
      "@oxfmt/binding-freebsd-x64",
      "@oxfmt/binding-linux-arm-gnueabihf",
      "@oxfmt/binding-linux-arm-musleabihf",
      "@oxfmt/binding-linux-arm64-gnu",
      "@oxfmt/binding-linux-arm64-musl",
      "@oxfmt/binding-linux-ppc64-gnu",
      "@oxfmt/binding-linux-riscv64-gnu",
      "@oxfmt/binding-linux-riscv64-musl",
      "@oxfmt/binding-linux-s390x-gnu",
      "@oxfmt/binding-linux-x64-musl",
      "@oxfmt/binding-openharmony-arm64",
      "@oxfmt/binding-win32-arm64-msvc",
      "@oxfmt/binding-win32-ia32-msvc",
      "@oxfmt/binding-win32-x64-msvc",
      "@oxlint-tsgolint/darwin-x64",
      "@oxlint-tsgolint/linux-arm64",
      "@oxlint-tsgolint/win32-arm64",
      "@oxlint-tsgolint/win32-x64",
      "@oxlint/binding-android-arm-eabi",
      "@oxlint/binding-android-arm64",
      "@oxlint/binding-darwin-x64",
      "@oxlint/binding-freebsd-x64",
      "@oxlint/binding-linux-arm-gnueabihf",
      "@oxlint/binding-linux-arm-musleabihf",
      "@oxlint/binding-linux-arm64-gnu",
      "@oxlint/binding-linux-arm64-musl",
      "@oxlint/binding-linux-ppc64-gnu",
      "@oxlint/binding-linux-riscv64-gnu",
      "@oxlint/binding-linux-riscv64-musl",
      "@oxlint/binding-linux-s390x-gnu",
      "@oxlint/binding-linux-x64-musl",
      "@oxlint/binding-openharmony-arm64",
      "@oxlint/binding-win32-arm64-msvc",
      "@oxlint/binding-win32-ia32-msvc",
      "@oxlint/binding-win32-x64-msvc",
      "@typescript/typescript-aix-ppc64",
      "@typescript/typescript-darwin-x64",
      "@typescript/typescript-freebsd-arm64",
      "@typescript/typescript-freebsd-x64",
      "@typescript/typescript-linux-arm",
      "@typescript/typescript-linux-arm64",
      "@typescript/typescript-linux-loong64",
      "@typescript/typescript-linux-mips64el",
      "@typescript/typescript-linux-ppc64",
      "@typescript/typescript-linux-riscv64",
      "@typescript/typescript-linux-s390x",
      "@typescript/typescript-netbsd-arm64",
      "@typescript/typescript-netbsd-x64",
      "@typescript/typescript-openbsd-arm64",
      "@typescript/typescript-openbsd-x64",
      "@typescript/typescript-sunos-x64",
      "@typescript/typescript-win32-arm64",
      "@typescript/typescript-win32-x64"
    ],
    "overrides": {
      "binaryen": "npm:@pre-bundled/binaryen@132.0.0-patch-1",
      "assemblyscript>binaryen": "npm:@pre-bundled/binaryen@131.0.0-nightly.20260721-patch-1",
      "@wildshard/format": "github:project-wildshard/shard-format#17539ea88a9b56449d6cf9af7739b7f298be112e"
    }
  }
}
